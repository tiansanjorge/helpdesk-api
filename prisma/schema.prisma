// HelpDesk — modelo de datos (borrador v1)
//
// Multi-tenancy: base compartida, cada tabla de negocio lleva `organizationId`.
// Regla de oro: TODA query filtra por el organizationId que sale del JWT (nunca del body/URL).
// Los IDs son UUID v7 (ordenables por tiempo, menos fragmentación de índices que v4).
// La URL de conexión no va acá: en Prisma 7 vive en prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  AGENT

  @@map("user_role")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

// Lista inicial; se ajusta a medida que aparezcan eventos reales.
enum ActivityAction {
  TICKET_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENT_ADDED
  ATTACHMENT_ADDED

  @@map("activity_action")
}

// ─── Modelos ──────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  // Contador del número de ticket. Se incrementa de forma atómica dentro de la
  // transacción que crea el ticket: el UPDATE bloquea la fila y serializa las
  // creaciones concurrentes de la misma organización.
  ticketSeq Int      @default(0) @map("ticket_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  users      User[]
  customers  Customer[]
  categories Category[]
  tickets    Ticket[]
  comments   Comment[]
  attachments Attachment[]
  activities ActivityLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Único global. Se guarda SIEMPRE en minúsculas (normalizar en el service).
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole
  // Los usuarios no se borran (comentarios e historial los referencian): se desactivan.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTickets Ticket[]      @relation("TicketAssignee")
  createdTickets  Ticket[]      @relation("TicketCreator")
  comments        Comment[]
  attachments     Attachment[]
  activities      ActivityLog[]

  @@index([organizationId])
  @@map("users")
}

// Contacto que abre tickets. No inicia sesión.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tickets      Ticket[]

  // También cubre las búsquedas por organizationId (prefijo izquierdo del índice).
  @@unique([organizationId, email])
  @@map("customers")
}

model Category {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Ticket {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  // Número legible por organización (#1, #2…). Ver Organization.ticketSeq.
  number         Int
  title          String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  customerId     String         @map("customer_id") @db.Uuid
  categoryId     String?        @map("category_id") @db.Uuid
  assigneeId     String?        @map("assignee_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments     Comment[]
  attachments  Attachment[]
  activities   ActivityLog[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt]) // listado filtrado
  @@index([organizationId, assigneeId, status]) // "mis tickets"
  @@index([organizationId, customerId]) // historial del cliente
  @@index([categoryId]) // el SET NULL al borrar una categoría necesita encontrar sus tickets
  @@map("tickets")
}

model Comment {
  id             String   @id @default(uuid(7)) @db.Uuid
  // Repetido a propósito (desnormalización): permite filtrar por tenant sin JOIN.
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("comments")
}

model Attachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  // Int alcanza (el límite de subida será de pocos MB) y evita el BigInt de JS,
  // que no se serializa a JSON sin un tratamiento especial.
  sizeBytes      Int      @map("size_bytes")
  // Clave del objeto en S3. El archivo en sí NO vive en la base.
  storageKey     String   @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("attachments")
}

model ActivityLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  ticketId       String         @map("ticket_id") @db.Uuid
  actorId        String         @map("actor_id") @db.Uuid
  action         ActivityAction
  // Payload variable según la acción, p. ej. { "from": "OPEN", "to": "CLOSED" }.
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("activity_logs")
}
